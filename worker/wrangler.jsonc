// Production name is discovery-watcher. database_id stays the all-zero
// placeholder until scripts/deploy-production.sh creates the D1 database and
// writes the real id here; local dev and the tests work with either.
{
  "name": "discovery-watcher",
  "workers_dev": true,
  "main": "src/index.ts",
  // The newest date the pinned wrangler 4.19.1 runtime (workerd 1.20250525.0) accepts.
  "compatibility_date": "2025-05-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discovery-watcher",
      "database_id": "c6ecbfda-6f88-4acc-a674-d3810d520411",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, used only by POST /embed (bge-base-en-v1.5). Local wrangler
  // dev reaches the real service for this binding; the tests never call it.
  "ai": { "binding": "AI" },
  // One r2_buckets key: a second one would replace this list, not add to it.
  // KNOWLEDGE holds the knowledge store's bytes (docs/KNOWLEDGE.md); VOICE
  // holds voice notes from the iPhone app (src/voice.ts), and
  // scripts/deploy-production.sh creates its bucket. Local wrangler dev
  // keeps its own copies under the state directory.
  "r2_buckets": [
    { "binding": "KNOWLEDGE", "bucket_name": "x-knowledge" },
    { "binding": "VOICE", "bucket_name": "discovery-voice" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WATCHER", "class_name": "WatcherDO" },
      // One per bridge task (src/bridge.ts): mailbox_complete wakes the
      // request waiting on it, so nothing polls D1.
      { "name": "BRIDGE_WAIT", "class_name": "BridgeWaitDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WatcherDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BridgeWaitDO"] }
  ],
  // Two crons, of the 5 Workers Free allows per account. */15 is the
  // dispatcher: each watcher's Durable Object alarm drives its checks, and
  // this sweep catches lost alarms, runs the approval, mailbox and voice work
  // and records itself for /health. "37 * * * *" retakes lens backgrounds in
  // an invocation of its own (LENS_CRON in src/index.ts), off the */15 marks.
  "triggers": { "crons": ["*/15 * * * *", "37 * * * *"] }
}
