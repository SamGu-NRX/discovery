#!/opt/homebrew/bin/python3
"""A stand-in for `codex exec` in tests: does the 'prep' in -C <dir> and writes prepared.json, like a real run."""
import json
import sys
from pathlib import Path

args = sys.argv[1:]
assert args[:1] == ["exec"], args
assert not any("dangerously" in a for a in args), "bypass flag passed to codex"
d = Path(args[args.index("-C") + 1])
(d / "patches").mkdir(exist_ok=True)
(d / "patches" / "0001-change.patch").write_text("--- a/x\n+++ b/x\n@@\n-old\n+new\n")
(d / "PREP.md").write_text("Prepared a patch.\n")
(d / "prepared.json").write_text(json.dumps({"verdict": "ready", "summary": "patch prepared",
    "items": [{"type": "file", "ref": "patches/0001-change.patch", "summary": "the change"}], "checks": []}))
print("tokens used\n1,000")
